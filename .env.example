# --- LLM ---------------------------------------------------------------
# With no key set, the app runs on a deterministic mock driver (good for
# plumbing tests, used by `npm run smoke`). Paste a key for real conversations.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# LLM_DRIVER=openai|mock        (default: auto — openai when a key is present)

# --- Instagram / Meta --------------------------------------------------
# Leave these empty to run in simulator mode (the local playground at /sim).
# Fill them after the SETUP.md click-path to go live against Meta.
META_APP_SECRET=
META_VERIFY_TOKEN=pick-any-string-and-paste-it-in-the-meta-dashboard
IG_ID=
IG_ACCESS_TOKEN=
# TRANSPORT=meta|sim            (default: auto — meta when a token is present)

# --- Shopify -----------------------------------------------------------
# Any storefront's public MCP endpoint works for catalog/cart/policies.
SHOPIFY_MCP_URL=https://gymshark.myshopify.com/api/mcp
BRAND_NAME=Gymshark (demo)

# Opener timing, seconds, 'min-max'. Default 0 = fire immediately (the brief's
# "fires fast"). Recommended live setting: 360-600 — a random 6-10 minute wait
# so the DM reads like a person noticed the comment, not a bot trigger.
# OPENER_DELAY_S=360-600
# Optional free-text brand instructions folded into every opener prompt:
# OPENER_BRAND_NOTES=always mention we ship worldwide; never use emoji

# Public nudge under the comment ("sent you a dm 💬"). A private reply to a
# NON-follower lands in their Requests folder unnotified — this is the fix.
# PUBLIC_NUDGE=non_followers|always|off   (default: non_followers)
# PUBLIC_NUDGE_TEXT=sent you a dm 💬

# Discounts: percent + one-per-customer are enforced in code, not by the model.
DISCOUNT_PERCENT=20
OPENER_DISCOUNT=true
# Optional: mint REAL codes on your own dev store via an Admin API custom app
# with the write_discounts scope. Without these, codes are simulated locally.
SHOPIFY_ADMIN_STORE=
SHOPIFY_ADMIN_TOKEN=

# --- Shipment tracking -------------------------------------------------
# Orders are PROTECTED CUSTOMER DATA: SHOPIFY_ADMIN_TOKEN above cannot read them
# (verified — ACCESS_DENIED). From a SECOND custom app on the store, installed
# with read_orders + read_fulfillments + write_webhooks: Settings → Apps and
# sales channels → Develop apps → your app → API credentials → Admin API token.
SHOPIFY_ORDERS_TOKEN=
# Same custom app → API credentials → "Webhook signing secret" (not the token).
# Unset, POST /webhooks/shopify refuses every non-simulated delivery with 503.
SHOPIFY_WEBHOOK_SECRET=
# Scan feeds are an ordered CHAIN, not a choice (src/shipping/provider.js):
#
#     aftership  →  easypost  →  simulated
#
# The first one with a key registers new packages; on an auth/quota refusal
# (401/402/403/429) it drops out of rotation for 30 minutes, the next one picks
# the package up, and GET /health reports which feed is carrying traffic.
#
# AfterShip tracker API (~2,000 couriers, city-level checkpoints):
# aftership.com → Settings → API keys → create a key with the Tracking scope.
AFTERSHIP_API_KEY=
# AfterShip → Notifications → Webhooks → add an endpoint:
#     https://stuck-fanatic-spew.ngrok-free.dev/webhooks/aftership
# The SAME page shows the account's webhook secret — paste it here. Set, every
# delivery must carry a matching `aftership-hmac-sha256` (base64 HMAC-SHA256 of
# the raw body) or it is refused with 401. Unset, a delivery is accepted only far
# enough to read a tracking id, which is then re-fetched from the API as truth.
# AFTERSHIP_WEBHOOK_SECRET=
# Version pin for the AfterShip API (breaking versions ship by date). Override
# only to move versions or to aim the driver at a staging/mock host.
# AFTERSHIP_API_BASE=https://api.aftership.com/tracking/2025-07
#
# EasyPost tracker API (checkpoint-level carrier scans): easypost.com → Account
# Settings → API Keys → Production (or Test) key. With AfterShip set, this is
# the failover feed. With neither set, trackers are simulated locally and only
# loopback tracker events are accepted.
EASYPOST_API_KEY=
# Where Shopify and the carrier feeds reach this app — the public tunnel, no
# trailing slash. Used by `npm run shopify:webhooks` to register
# PUBLIC_BASE_URL/webhooks/shopify.
# PUBLIC_BASE_URL=https://stuck-fanatic-spew.ngrok-free.dev

# Reply pacing: 'natural' = read receipt + typing indicator + reading-speed
# delay on DM replies; 'instant' = reply as fast as the model returns.
# REPLY_PACING=natural

# --- Server ------------------------------------------------------------
PORT=3000
# DB_PATH=data/concierge.db

# Live-walkthrough workflows: gate the promo behind a phone number (W1/W2)
PHONE_GATE=0
# The "sell it out" product; resolved live via MCP for the hydrated cart link.
FEATURED_PRODUCT=
# Optional store-wide pre-created code (skips per-customer minting).
PROMO_CODE=
# Cart-permalink domain; defaults to the SHOPIFY_MCP_URL host.
STORE_DOMAIN=

# --- Kosha (Supabase) mirror -------------------------------------------
# Optional. When set (and TRANSPORT is not 'sim'), customers, conversations
# and messages are mirrored into the Kosha private.* schema, and the active
# private.ig_goals row drives the capture workflow + featured product every 30s.
# Empty = off; the concierge runs on SQLite alone.
DATABASE_URL=
# Which brand's instagram inbox to bind to (resolved by SELECT at boot).
# SUPABASE_BRAND_ID=saru-dev-lab

# --- Agent-initiated escalation ----------------------------------------
# When the agent flags a conversation for a human (escalate_to_human), this is
# how long that flag may sit unanswered before ONE courtesy dm goes out
# ("still on your question — checking with the team"). Minutes; fractional is
# allowed so a walkthrough can watch it happen. A human reply through
# /operator/send resolves the flag and cancels the dm.
# ESCALATION_FOLLOWUP_MIN=20

# --- Capability console (/console) --------------------------------------
# The console is admin-key gated (?key=ADMIN_KEY) and drives a DEDICATED sim
# child — a second copy of this server on loopback with TRANSPORT=sim and its
# own throwaway db — so suites can run against the REAL model and the REAL
# store while the live server keeps talking to Meta. The child boots on the
# first run, stays up between runs and dies with the parent.
# CONSOLE_PORT=3901
# CONSOLE_DB_PATH=data/console.db
# 'openai' (the point — judging real behavior) or 'mock' (what smoke uses).
# CONSOLE_LLM_DRIVER=openai
# The child's escalation threshold, in minutes — seconds, so the follow-up is
# something you can sit and watch.
# CONSOLE_FOLLOWUP_MIN=0.15
